PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/cleancity

JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@cleancity.local
ADMIN_PASSWORD=change_this_password

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key
SUPABASE_STORAGE_BUCKET=waste-reports
